CI_ENVIRONMENT = production
app.baseURL = 'http://127.0.0.1:8080/'
app.demoMode = false

# Bancos distintos; preencha usuários/senhas exclusivos criados no MySQL.
database.defaultGroup = demo
database.default.database = projeto_estagio

database.demo.hostname = 127.0.0.1
database.demo.port = 3306
database.demo.database = projeto_estagio_b2b
database.demo.username =
database.demo.password =
database.demo.DBDriver = MySQLi
database.demo.DBPrefix =

database.tests.hostname = 127.0.0.1
database.tests.port = 3306
database.tests.database = projeto_estagio_tests
database.tests.username =
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =

